{
  "imports": {
    "hono": "jsr:@hono/hono@^4.7",
    "hono/": "jsr:@hono/hono@^4.7/"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --unstable-kv main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --unstable-kv main.ts"
  },
  "fmt": {
    "exclude": ["README.md"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
